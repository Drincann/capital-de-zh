  "sentences": [
    {
      "id": "ch05-s01-n0025",
      "text": "劳动不仅需要身体持续用力，也要求劳动者始终围绕既定目的保持专注。",
      "start_ms": 120,
      "end_ms": 6000,
      "timing_source": "provider_subtitle"
    },
    {
      "id": "ch05-s01-n0026",
      "text": "劳动越枯燥，劳动者越难从中感到自己是在自由运用体力和智力，也就越需要靠意志强迫自己专心。",
      "start_ms": 6440,
      "end_ms": 15800,
      "timing_source": "provider_subtitle"
    },
    {
      "id": "ch05-s01-n0027",
      "text": "劳动过程包含三个基本部分。",
      "start_ms": 16600,
      "end_ms": 18880,
      "timing_source": "provider_subtitle"
    },
    {
      "id": "ch05-s01-n0028",
      "text": "第一是有目的的活动，也就是劳动本身。",
      "start_ms": 19720,
      "end_ms": 22840,
      "timing_source": "provider_subtitle"
    },
    {
      "id": "ch05-s01-n0029",
      "text": "第二是劳动所作用的对象。",
      "start_ms": 23120,
      "end_ms": 24880,
      "timing_source": "provider_subtitle"
    },
    {
      "id": "ch05-s01-n0030",
      "text": "第三是劳动时使用的工具和其他手段。",
      "start_ms": 25240,
      "end_ms": 28120,
      "timing_source": "provider_subtitle"
    }
  ]
}
